{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "labels": [
    "dependencies"
  ],
  "extends": [
    "config:recommended",
    ":semanticCommits"
  ],
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "on monday"
    ]
  },
  "packageRules": [
    {
      "description": "Keep the Rust builder image on the toolchain line; Cargo.toml's rust-version is the MSRV, not a pin.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "rust"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)(\\.(?<patch>\\d+))?-(?<compatibility>.+)$"
    }
  ]
}
